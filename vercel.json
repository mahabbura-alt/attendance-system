{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "admin-dashboard/**",
      "use": "@vercel/static"
    },
    {
      "src": "mobile-web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/Absensi_PIM.apk",
      "dest": "api/index.js"
    },
    {
      "src": "/Absensi%20PIM.apk",
      "dest": "api/index.js"
    },
    {
      "src": "/download-apk",
      "dest": "api/index.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/health",
      "dest": "api/index.js"
    },
    {
      "src": "/mobile-web/(.*)",
      "dest": "mobile-web/$1"
    },
    {
      "src": "/mobile/(.*)",
      "dest": "mobile-web/$1"
    },
    {
      "src": "/mobile",
      "dest": "mobile-web/index.html"
    },
    {
      "src": "/portal/(.*)",
      "dest": "mobile-web/$1"
    },
    {
      "src": "/karyawan.html",
      "dest": "mobile-web/index.html"
    },
    {
      "src": "/karyawan",
      "dest": "mobile-web/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "admin-dashboard/$1"
    }
  ],
  "headers": [
    {
      "source": "(.*).js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "(.*).css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" }
      ]
    },
    {
      "source": "(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ]
}
