{
  "version": 2,
  "builds": [
    {
      "src": "admin-dashboard/**",
      "use": "@vercel/static"
    },
    {
      "src": "mobile-web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/Absensi_PIM.apk",
      "dest": "https://omos-mining.com/Absensi_PIM.apk"
    },
    {
      "src": "/Absensi%20PIM.apk",
      "dest": "https://omos-mining.com/Absensi_PIM.apk"
    },
    {
      "src": "/download-apk",
      "dest": "https://omos-mining.com/download-apk"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://omos-mining.com/api/$1"
    },
    {
      "src": "/health",
      "dest": "https://omos-mining.com/health"
    },
    {
      "src": "/(.*)",
      "status": 308,
      "headers": {
        "Location": "https://omos-mining.com/$1"
      }
    }
  ],
  "headers": [
    {
      "source": "(.*).js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "(.*).css",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" }
      ]
    },
    {
      "source": "(.*)",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    }
  ]
}
