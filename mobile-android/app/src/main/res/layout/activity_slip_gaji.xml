<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#1a7a4a"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Kembali"
                android:padding="6dp"
                android:tint="#ffffff"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Unduh Slip Gaji"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#ffffff"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_margin="16dp"
            android:elevation="4dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PT. Prima Indojaya Mandiri"
                android:textColor="#1a7a4a"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Construction - Earthmoving - Mining"
                android:textColor="#888888"
                android:textSize="11sp"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#e8e8e8"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Bulan"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/spinnerBulan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="14dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Tahun"
                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/spinnerTahun"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"/>
            <TextView
                android:id="@+id/tvStatusDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#1a7a4a"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>
            <ProgressBar
                android:id="@+id/progressDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="12dp"/>
            <Button
                android:id="@+id/btnUnduhSlip"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Unduh Slip Gaji PDF"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#1a7a4a"
                android:stateListAnimator="@null"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#fff8e1"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Informasi Keamanan"
                android:textColor="#e67e00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="File PDF terenkripsi dan hanya bisa dibuka dengan password akun Anda. Slip gaji bersifat rahasia, hanya untuk keperluan pribadi. File tersimpan di folder Downloads perangkat Anda."
                android:textColor="#6d4c00"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.4"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
