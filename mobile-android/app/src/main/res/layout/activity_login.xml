<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Absensi Karyawan"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masuk untuk mulai absensi"
            android:textSize="14sp"
            android:textColor="#4A5568"
            android:layout_marginBottom="32dp" />

        <EditText
            android:id="@+id/inputEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:textColor="#1A1A2E"
            android:textColorHint="#666666"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/inputPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password"
            android:textColor="#1A1A2E"
            android:textColorHint="#666666"
            android:inputType="textPassword"
            android:padding="14dp"
            android:background="@drawable/bg_input_field"
            android:layout_marginBottom="22dp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MASUK"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="14dp"
            android:backgroundTint="#1A1A2E" />

        <TextView
            android:id="@+id/textError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- Lupa Password -->
        <TextView
            android:id="@+id/textLupaPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lupa Password?"
            android:textColor="#0D47A1"
            android:textStyle="bold"
            android:textSize="14sp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CBD5E0"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum punya akun?"
            android:textColor="#2D3748"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnDaftar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DAFTAR AKUN BARU"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:padding="14dp"
            android:backgroundTint="#283593" />

        <TextView
            android:id="@+id/btnSetIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Pengaturan Server IP"
            android:textColor="#718096"
            android:textSize="12sp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp" />

    </LinearLayout>
</ScrollView>
