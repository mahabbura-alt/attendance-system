<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBackGpsCalibration"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="‹ Kembali"
            android:textColor="#0F766E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kalibrasi GPS"
            android:textColor="#0F172A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ambil beberapa fix GPS baru dan pilih koordinat dengan akurasi terbaik sebelum melakukan absensi."
            android:textColor="#64748B"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/textGpsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tekan Mulai Kalibrasi untuk mencari koordinat."
                android:textColor="#166534"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressGpsCalibration"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="18dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textGpsCoordinate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="monospace"
                android:text="Latitude: —\nLongitude: —"
                android:textColor="#0F172A"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/textGpsAccuracy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Akurasi: —"
                android:textColor="#334155"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/textGpsSamples"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sampel valid: 0"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartGpsCalibration"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#0F766E"
            android:text="Mulai Kalibrasi"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenLocationSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#E2E8F0"
            android:text="Buka Pengaturan Lokasi"
            android:textAllCaps="false"
            android:textColor="#0F172A" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tips: berdiri di area terbuka, jauh dari bangunan tinggi, aktifkan mode lokasi presisi, dan diam selama pengukuran. Kalibrasi tidak otomatis mencatat absensi."
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
