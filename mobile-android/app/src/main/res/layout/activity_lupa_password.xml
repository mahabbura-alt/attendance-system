<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F5F5F5">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lupa Password"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="8dp" />

    <!-- Langkah 1: Input Email -->
    <LinearLayout
        android:id="@+id/layoutLangkah1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masukkan email akun Anda. Token reset akan dikirim ke email tersebut."
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/inputEmailReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email terdaftar"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:background="@android:color/white"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnKirimToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kirim Token Reset"
            android:padding="14dp"
            android:backgroundTint="#1A1A2E" />

    </LinearLayout>

    <!-- Langkah 2: Input Token + Password Baru -->
    <LinearLayout
        android:id="@+id/layoutLangkah2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/textInfoEmail"
            android:text="Token dikirim ke email Anda. Masukkan token 6 digit dan password baru."
            android:textSize="13sp"
            android:textColor="#2E7D32"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/inputToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Token 6 digit (dari email)"
            android:inputType="number"
            android:maxLength="6"
            android:gravity="center"
            android:textSize="20sp"
            android:letterSpacing="0.3"
            android:padding="16dp"
            android:background="@android:color/white"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/inputPasswordBaru"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Password baru (min. 8 karakter)"
            android:inputType="textPassword"
            android:padding="14dp"
            android:background="@android:color/white"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/inputKonfirmasiPasswordBaru"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Konfirmasi password baru"
            android:inputType="textPassword"
            android:padding="14dp"
            android:background="@android:color/white"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnResetPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reset Password"
            android:padding="14dp"
            android:backgroundTint="#1A1A2E" />

    </LinearLayout>

    <TextView
        android:id="@+id/textPesanReset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textSize="14sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textKembaliLogin2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kembali ke Login"
        android:textColor="#1565C0"
        android:textSize="14sp"
        android:paddingTop="20dp" />

</LinearLayout>
