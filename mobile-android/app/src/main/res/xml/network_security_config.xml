<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Izinkan HTTP ke localhost, emulator (10.0.2.2), dan IP jaringan lokal -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.254.129</domain>
        <domain includeSubdomains="true">192.168.1.82</domain>
        <domain includeSubdomains="true">192.168.1.112</domain>
    </domain-config>
    <!-- Izinkan HTTP untuk pengembangan lokal di HP fisik -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
