{
  "name": "attendance-backend",
  "version": "1.0.0",
  "description": "Backend API aplikasi absensi karyawan (GPS geofencing + verifikasi wajah via CompreFace)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "test": "node --test",
    "retention:dry": "node src/scripts/purgeExpiredPhotos.js",
    "retention:execute": "node src/scripts/purgeExpiredPhotos.js --execute",
    "migration": "node -r dotenv/config -e \"require('./src/config/db').pool.query(require('fs').readFileSync('./migrations/001_tambah_fitur_baru.sql','utf8')).then(()=>{console.log('Migration OK');process.exit(0)}).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "migrate:supabase": "node -r dotenv/config -e \"require('./src/config/db').pool.query(require('fs').readFileSync('./sql/002_supabase_migration.sql','utf8')).then(()=>{console.log('Supabase Migration OK');process.exit(0)}).catch(e=>{console.error(e.message);process.exit(1)})\"",
    "verify:supabase": "node src/scripts/verifySupabase.js",
    "rollback:local": "node src/scripts/rollbackLocal.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.112.1",
    "axios": "^1.19.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "form-data": "^4.0.1",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.1",
    "multer": "^2.0.1",
    "nodemailer": "^6.10.1",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "xlsx": "^0.18.5"
  }
}
